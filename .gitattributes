# 1. GLOBAL DEFAULTS
# -----------------
# Handle all files automatically:
# - If Git thinks it's text, it normalizes to LF in the repo.
# - On checkout, it uses the OS native line ending (CRLF on Win, LF on Mac/Linux).
* text=auto

# 2. FORCE LF (Unix-style)
# -----------------------
# These files MUST use LF, even on Windows (e.g., for Docker or shell execution).
*.sh          text    eol=lf
*.bash        text    eol=lf
*.zsh         text    eol=lf
.env          text    eol=lf
Dockerfile    text    eol=lf

# 3. FORCE CRLF (Windows-style)
# ----------------------------
# These files MUST use CRLF to work correctly in Windows environments.
*.bat         text    eol=crlf
*.cmd         text    eol=crlf
*.ps1         text    eol=crlf
*.sln         text    eol=crlf

# 4. EXPLICIT TEXT TYPES
# ----------------------
# Helps Git identify text files it might otherwise misclassify.
*.txt         text
*.md          text
*.json        text
*.js          text
*.ts          text
*.css         text
*.html        text
*.yml         text
*.yaml        text
*.xml         text
*.sql         text

# 5. BINARY FILES
# ---------------
# Tell Git NOT to touch these. They are not text and should never be normalized.
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.pdf         binary
*.mov         binary
*.mp4         binary
*.zip         binary
*.gz          binary
*.exe         binary
*.dll         binary